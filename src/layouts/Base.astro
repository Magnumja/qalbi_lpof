---
import '@fontsource/crimson-text/latin-400.css';
import '@fontsource/crimson-text/latin-400-italic.css';
import '@fontsource/red-hat-text/latin-400.css';
import '@fontsource/red-hat-text/latin-500.css';
import '../styles/global.css';
import { site } from '../content/site';
interface Props {
  title?: string;
  description?: string;
  privatePage?: boolean;
}
const {
  title = 'Qalbi Atelier — Tu historia, hecha a mano',
  description = site.description,
  privatePage = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#53573D" />
    <title>{title}</title>
    {privatePage && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/svg+xml" href="/brand/anthurium.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import { observeReveal } from '../lib/reveal';

      observeReveal(document.querySelectorAll('[data-reveal]'), (element) => [
        element.animate(
          [
            { opacity: 0, translate: '0 18px' },
            { opacity: 1, translate: '0 0' },
          ],
          { duration: 650, easing: 'cubic-bezier(.2,.7,.2,1)' },
        ),
      ]);
      observeReveal(
        document.querySelectorAll('[data-animated-text]'),
        (text) =>
          Array.from(text.querySelectorAll('[data-letter]'), (letter, index) =>
            letter.animate(
              [
                { opacity: 0, transform: 'translateY(0.3em) rotate(4deg)' },
                { opacity: 1, transform: 'translateY(0) rotate(0)' },
              ],
              {
                duration: 650,
                delay: Math.min(index * 28, 360),
                easing: 'cubic-bezier(.16,1,.3,1)',
                fill: 'backwards',
              },
            ),
          ),
        0.5,
      );
    </script>
  </body>
</html>
