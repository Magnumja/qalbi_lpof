---
import { Image } from 'astro:assets';
import embroidery from '../assets/photos/embroidery.jpg';
import Arrow from './Arrow.astro';
import { contactUrl } from '../content/site';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="little-star" aria-hidden="true">
        ✳
      </span>{' '}
      Un pequeño atelier. Muchas historias.
    </p>
    <h1 id="hero-title">
      Tu historia,
      <br />
      hecha <em>a mano.</em>
    </h1>
    <p class="hero-description">
      Para esa persona. Para ese momento.
      <br />
      Bordado, ganchillo e ilustración que convierten
      <br class="desktop-break" /> lo que sientes en algo que puedes abrazar.
    </p>
    <div class="hero-actions">
      <a
        class="button"
        id="hero-contact"
        href={contactUrl()}
        target="_blank"
        rel="noreferrer"
      >
        Cuéntame tu idea <Arrow diagonal />
      </a>
      <a class="explore-link" href="#creaciones">
        Explorar creaciones <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-note">
      <span class="note-line" aria-hidden="true"></span>
      <p>
        Hecho con calma, en Málaga.
        <br />
        <em>Y siempre, con el corazón.</em>
      </p>
    </div>
  </div>
  <div class="hero-art">
    <div class="photo-outline" aria-hidden="true"></div>
    <figure class="hero-photo">
      <Image
        src={embroidery}
        alt="Bastidor Qalbi bordado a mano con flores y la frase: Lo que toca el alma nunca se olvida"
        width={540}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Pequeños detalles. Grandes significados.</figcaption>
    </figure>
    <div class="flower-stamp" aria-hidden="true">
      <span>HECHO A MANO</span>
      <img src="/brand/anthurium.svg" width="65" height="83" alt="" />
      <span>CON EL CORAZÓN</span>
    </div>
    <div class="little-label" aria-hidden="true">
      una pieza,
      <br />
      <em>algo de ti.</em>
    </div>
    <svg class="thread" viewBox="0 0 200 125" fill="none" aria-hidden="true">
      <path
        d="M2 70C48 13 75 136 112 92c42-51-19-80-35-48-22 45 81 63 117-37"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
      />
    </svg>
  </div>
</section>
<div
  class="craft-strip"
  aria-label="Bordado, ganchillo, ilustración y regalos con intención"
>
  <div class="wrap">
    <span>Bordado</span>
    <span aria-hidden="true">✳</span>
    <span>Ganchillo</span>
    <span aria-hidden="true">✳</span>
    <span>Ilustración</span>
    <span aria-hidden="true">✳</span>
    <span>Regalos con intención</span>
    <span aria-hidden="true">✳</span>
    <span class="strip-extra">Hecho con el corazón</span>
  </div>
</div>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 4.25rem;
    padding-bottom: 4.75rem;
    min-height: 750px;
  }
  .hero-copy {
    padding-bottom: 1.5rem;
  }
  .hero-copy .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }
  .little-star {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
  }
  .hero h1 {
    font-size: clamp(4rem, 7.25vw, 7rem);
    letter-spacing: -0.047em;
    line-height: 0.99;
    margin-bottom: 1.7rem;
    white-space: nowrap;
  }
  .hero h1 em {
    color: var(--clay);
  }
  .hero-description {
    font-size: 0.91rem;
    line-height: 1.8;
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.65rem;
    margin-top: 2rem;
  }
  .explore-link {
    font-size: 0.76rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
  }
  .explore-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-note {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 3.3rem;
  }
  .hero-note p {
    font-size: 0.65rem;
    line-height: 1.7;
  }
  .hero-note em {
    font-family: var(--serif);
    font-size: 1rem;
  }
  .note-line {
    width: 32px;
    border-top: 1px solid var(--moss);
  }
  .hero-art {
    position: relative;
    width: 100%;
    max-width: 530px;
    justify-self: end;
    padding: 0 1.5rem 0 1rem;
  }
  .hero-photo {
    position: relative;
    border-radius: 47% 47% 3px 3px;
    overflow: hidden;
    aspect-ratio: 0.88;
    background: var(--rose);
  }
  .hero-photo img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 50%;
  }
  .hero-photo figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, #202214a3);
    color: var(--paper);
    padding: 2.75rem 1rem 1rem;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
  }
  .photo-outline {
    position: absolute;
    inset: 12px 9px -12px 28px;
    border: 1px solid var(--moss);
    border-radius: 47% 47% 3px 3px;
    opacity: 0.48;
    transform: rotate(3deg);
  }
  .flower-stamp {
    position: absolute;
    left: -42px;
    top: 35px;
    width: 117px;
    height: 149px;
    border: 1px solid var(--moss);
    background: var(--paper);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.35rem;
    transform: rotate(-14deg);
    box-shadow: 0 0 0 5px var(--paper);
  }
  .flower-stamp img {
    width: 57px;
    height: 73px;
  }
  .flower-stamp span {
    font-size: 0.46rem;
    letter-spacing: 0.12em;
  }
  .little-label {
    position: absolute;
    right: -8px;
    bottom: 45px;
    padding: 1.05rem 1.6rem;
    line-height: 1.05;
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--paper);
    background: var(--clay);
    transform: rotate(8deg);
    box-shadow: 0 0 0 4px var(--paper);
    border: 1px dashed var(--rose);
    outline: 5px solid var(--clay);
  }
  .thread {
    position: absolute;
    bottom: -43px;
    left: -97px;
    width: 155px;
    height: 97px;
    color: var(--clay);
    transform: rotate(-8deg);
  }
  .craft-strip {
    background: var(--rose);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1.15rem 0;
  }
  .craft-strip .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .craft-strip span {
    font-family: var(--serif);
    font-size: 1.18rem;
    white-space: nowrap;
  }
  .craft-strip span[aria-hidden] {
    font-size: 1rem;
    color: var(--clay);
  }
  @media (min-width: 1500px) {
    .hero {
      min-height: 830px;
    }
  }
  @media (max-width: 1050px) and (min-width: 701px) {
    .hero {
      gap: 1.5rem;
      min-height: 660px;
    }
    .hero h1 {
      font-size: 6.7vw;
    }
    .hero-art {
      padding-left: 1.5rem;
    }
    .hero-actions {
      align-items: start;
      flex-direction: column;
      gap: 0.3rem;
    }
    .flower-stamp {
      left: -8px;
      width: 94px;
      height: 121px;
    }
    .flower-stamp img {
      height: 55px;
    }
    .hero-note {
      margin-top: 1.5rem;
    }
    .strip-extra {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 2.25rem;
      padding-bottom: 3.5rem;
      gap: 1.75rem;
      min-height: 0;
    }
    .hero-copy {
      padding-bottom: 0;
    }
    .hero-copy .eyebrow {
      margin-bottom: 1.4rem;
      font-size: 0.57rem;
      gap: 0.5rem;
    }
    .hero h1 {
      font-size: clamp(3.35rem, 12.3vw, 5.2rem);
      margin-bottom: 1.15rem;
      white-space: normal;
    }
    .hero-description {
      font-size: 0.95rem;
      line-height: 1.8;
    }
    .desktop-break {
      display: none;
    }
    .hero-actions {
      margin-top: 1.3rem;
      gap: 1.2rem;
      justify-content: space-between;
    }
    .hero-actions .button {
      padding: 0.75rem 1.2rem;
      font-size: 0.76rem;
      gap: 1rem;
    }
    .explore-link {
      font-size: 0.67rem;
      gap: 0.45rem;
    }
    .hero-note {
      display: none;
    }
    .hero-art {
      max-width: 380px;
      justify-self: center;
      padding: 0 1rem;
      margin-top: 0.4rem;
    }
    .hero-photo {
      aspect-ratio: 1.02;
      border-radius: 47% 47% 3px 3px;
    }
    .hero-photo img {
      object-position: center 49%;
    }
    .flower-stamp {
      left: 0;
      top: 14px;
      width: 83px;
      height: 108px;
      gap: 0.2rem;
    }
    .flower-stamp span {
      font-size: 0.34rem;
    }
    .flower-stamp img {
      width: 44px;
      height: 56px;
    }
    .little-label {
      right: 4px;
      bottom: 23px;
      font-size: 1.08rem;
      padding: 0.6rem 1rem;
    }
    .photo-outline {
      inset: 9px 5px -9px 25px;
    }
    .thread {
      width: 100px;
      height: 63px;
      bottom: -31px;
      left: -3px;
    }
    .hero-photo figcaption {
      font-size: 0.86rem;
      padding-bottom: 0.65rem;
    }
    .craft-strip {
      padding: 0.85rem 0;
    }
    .craft-strip .wrap {
      gap: 0.6rem;
      justify-content: space-between;
    }
    .craft-strip span {
      font-size: 0.86rem;
    }
    .craft-strip span[aria-hidden] {
      font-size: 0.7rem;
    }
    .craft-strip .strip-extra,
    .craft-strip span:nth-last-child(2),
    .craft-strip span:nth-last-child(3) {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .hero-actions {
      gap: 0.5rem;
    }
    .hero-actions .button {
      padding: 0.6rem 0.85rem;
      gap: 0.6rem;
    }
    .explore-link {
      font-size: 0.62rem;
    }
    .hero h1 {
      font-size: 3.2rem;
    }
  }
</style>
