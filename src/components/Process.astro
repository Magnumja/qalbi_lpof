---
import Arrow from './Arrow.astro';
import { contactUrl } from '../content/site';
const steps = [
  {
    number: '01',
    title: 'Cuéntame tu idea',
    text: 'Una persona, una ocasión, un recuerdo. No hace falta tenerlo todo claro: ese es nuestro punto de partida.',
    symbol: 'idea',
  },
  {
    number: '02',
    title: 'Le damos forma',
    text: 'Hablamos de los detalles, las posibilidades, el presupuesto y el tiempo que necesita tu pieza.',
    symbol: 'thread',
  },
  {
    number: '03',
    title: 'Algo muy tuyo',
    text: 'Tu historia se convierte en una creación hecha a mano. Acordamos cómo llegará a ti.',
    symbol: 'gift',
  },
];
---

<section class="process-section" id="encargos" aria-labelledby="process-title">
  <div class="wrap section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">03 / De una idea a tus manos</p>
        <h2 id="process-title">
          Todo empieza
          <br />
          <em>con una conversación.</em>
        </h2>
      </div>
      <p>
        No necesitas encontrar la pieza perfecta.
        <br />
        Podemos imaginarla juntos.
      </p>
    </div>
    <div class="steps">
      {steps.map((step) => (
        <article class="step" data-reveal>
          <div class="step-top">
            <span class="step-number">{step.number}</span>
            <svg
              viewBox="0 0 60 60"
              width="58"
              height="58"
              fill="none"
              aria-hidden="true"
            >
              {step.symbol === 'idea' ? (
                <>
                  <path d="M18 38C3 13 45 1 45 24c0 7-10 12-10 20H23l-5-6Zm6 11h11M26 54h7M9 14 5 10M48 9l5-4M5 30H1M51 31h7M25 5V1" />
                  <path d="M27 42V26l-5-5m5 5 7-6" />
                </>
              ) : step.symbol === 'thread' ? (
                <>
                  <ellipse cx="29" cy="12" rx="17" ry="7" />
                  <path d="M12 12v33c0 10 34 10 34 0V12M14 23l30-7M14 33l30-8M14 42l30-8M17 48l27-7M30 50c-2 13 26 8 25-2" />
                </>
              ) : (
                <>
                  <path d="M10 24h40v29H10V24Zm-4-9h48v10H6V15Zm23 0v38M29 15C7 16 13-6 24 6l5 9Zm0 0C52 15 44-6 35 6l-6 9Z" />
                </>
              )}
            </svg>
          </div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
    <div class="process-bottom">
      <p>
        ¿Tu idea es muy específica? <em>Mejor todavía.</em>
      </p>
      <a class="text-link" href={contactUrl()} target="_blank" rel="noreferrer">
        Vamos a imaginarla <Arrow diagonal />
      </a>
    </div>
  </div>
</section>
<style>
  .process-section {
    background: var(--rose);
    position: relative;
    border-block: 1px solid var(--line);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    gap: 3rem;
  }
  .step {
    position: relative;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .step-number {
    font-family: var(--serif);
    font-size: 3.25rem;
    line-height: 1;
    opacity: 0.65;
  }
  .step svg {
    stroke: var(--moss);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(-8deg);
  }
  .step h3 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .step p {
    font-size: 0.84rem;
    line-height: 1.8;
    max-width: 310px;
    color: var(--ink);
  }
  .process-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .process-bottom p {
    font-family: var(--serif);
    font-size: 1.5rem;
  }
  @media (max-width: 700px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
    }
    .step {
      padding-top: 1.2rem;
      display: grid;
      grid-template-columns: 70px 1fr;
      gap: 0 1rem;
    }
    .step-top {
      display: contents;
    }
    .step-number {
      grid-column: 1;
      grid-row: 1 / 3;
      font-size: 2.65rem;
    }
    .step svg {
      display: none;
    }
    .step h3 {
      font-size: 1.8rem;
      margin-bottom: 0.55rem;
      grid-column: 2;
    }
    .step p {
      grid-column: 2;
      max-width: 100%;
      font-size: 0.95rem;
    }
    .process-bottom {
      display: block;
      margin-top: 2rem;
    }
    .process-bottom p {
      font-size: 1.3rem;
      margin-bottom: 0.85rem;
    }
  }
</style>
