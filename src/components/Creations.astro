---
import AnimatedText from './AnimatedText.astro';
import { getImage } from 'astro:assets';
import { pieces } from '../content/pieces';
import type { GalleryPiece } from '../content/types';
import PublishedGallery from './home/PublishedGallery';
// O Astro cria versões leves das fotos; você cadastra apenas a imagem original.
const images: GalleryPiece[] = await Promise.all(
  pieces.map(async ({ image, ...piece }) => {
    const widths = [240, 480];
    const variants = await Promise.all(
      widths.map((width) => getImage({ src: image, width, format: 'webp' })),
    );
    return {
      ...piece,
      src: variants[1].src,
      srcSet: variants
        .map((image, i) => `${image.src} ${widths[i]}w`)
        .join(', '),
      width: image.width,
      height: image.height,
    };
  }),
);
---

<section class="section wrap" id="creaciones" aria-labelledby="creations-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">01 / Pequeñas cosas, mucho significado</p>
      <h2 id="creations-title">
        Un poquito de hilo.
        <br />
        <em>
          <AnimatedText text="Mucho de ti." />
        </em>
      </h2>
    </div>
    <p>
      Para regalar, para recordar o simplemente para ti. Encuentra el comienzo
      de tu próxima historia.
    </p>
  </div>
  <PublishedGallery fallback={images} client:load />
</section>
