---
import { getImage } from 'astro:assets';
import { pieces } from '../content/pieces';
import CreationGallery from './CreationGallery';
const images = await Promise.all(
  pieces.map(async (piece) => {
    const widths = [240, 480];
    const variants = await Promise.all(
      widths.map((width) =>
        getImage({ src: piece.image, width, format: 'webp' }),
      ),
    );
    return {
      ...piece,
      image: undefined,
      src: variants[1].src,
      srcSet: variants
        .map((image, i) => `${image.src} ${widths[i]}w`)
        .join(', '),
      width: piece.image.width,
      height: piece.image.height,
    };
  }),
);
---

<section class="section wrap" id="creaciones" aria-labelledby="creations-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">01 / Pequeñas cosas, mucho significado</p>
      <h2 id="creations-title">
        Un poquito de hilo.
        <br />
        <em>Mucho de ti.</em>
      </h2>
    </div>
    <p>
      Para regalar, para recordar o simplemente para ti. Encuentra el comienzo
      de tu próxima historia.
    </p>
  </div>
  <CreationGallery pieces={images} client:visible />
</section>
