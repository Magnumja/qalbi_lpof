---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Creations from '../components/Creations.astro';
import Atelier from '../components/Atelier.astro';
import Process from '../components/Process.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Creations />
    <Atelier />
    <Process />
    <Closing />
  </main>
  <Footer />
</Base>

<script>
  import { loadHome } from '../components/home/load-home';
  loadHome()
    .then(({ content }) => {
      for (const [key, photo] of Object.entries(content.photos)) {
        const img = document.querySelector<HTMLImageElement>(
          `[data-home-photo="${key}"]`,
        );
        if (!img) continue;
        // Só substitui a imagem original depois de a nova foto carregar com sucesso.
        const preload = new Image();
        preload.onload = () => {
          img.removeAttribute('srcset');
          img.src = photo.src;
          img.alt = photo.alt;
        };
        preload.src = photo.src;
      }
    })
    .catch(() => {
      /* O HTML original continua funcionando sem a API. */
    });
</script>
