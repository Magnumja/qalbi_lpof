---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopApp from '../components/shop/ShopApp';
---

<Base
  title="Tienda — Qalbi Atelier"
  description="Bordado, ganchillo e ilustración hechos a mano en Málaga. Piezas listas para enviar y creaciones bajo pedido."
>
  <Header />
  <ShopApp mode="store" client:load />
  <noscript>
    <p class="wrap">
      Activa JavaScript para acceder a la tienda y gestionar tus pedidos.
    </p>
  </noscript>
  <Footer />
</Base>
