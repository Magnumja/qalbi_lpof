{
  "name": "qalbi-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format:check": "prettier --check src tests e2e scripts server api playwright.config.mjs .github astro.config.mjs tsconfig.json package.json vercel.json render.yaml",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests e2e scripts server api playwright.config.mjs .github astro.config.mjs tsconfig.json package.json vercel.json render.yaml",
    "validate": "npm run format:check && npm run check && npm test && npm run test:server && npm run build",
    "server:dev": "npm run dev --workspace=@qalbi/server",
    "db:migrate": "npm run migrate --workspace=@qalbi/server",
    "test:server": "npm test --workspace=@qalbi/server",
    "db:test": "scripts/test-db.sh",
    "test:e2e": "playwright test",
    "forget": "npm run forget --workspace=@qalbi/server"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "astro": "^7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "workspaces": [
    "server"
  ]
}
