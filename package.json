{
  "name": "qalbi-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format:check": "prettier --check src tests .github astro.config.mjs tsconfig.json package.json",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests .github astro.config.mjs tsconfig.json package.json",
    "validate": "npm run format:check && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "astro": "^7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
