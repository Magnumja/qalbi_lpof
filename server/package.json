{
  "name": "@qalbi/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/index.mjs",
    "migrate": "node --env-file-if-exists=.env src/migrate.mjs",
    "admin": "node --env-file-if-exists=.env src/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "forget": "node --env-file-if-exists=.env src/forget.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  }
}
