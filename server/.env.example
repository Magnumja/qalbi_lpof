# Backend local. Gere as URLs com `npm run db:test` (imprime exports) ou aponte para o seu PostgreSQL.
DATABASE_URL=postgresql://qalbi@127.0.0.1:55432/qalbi_dev
TEST_DATABASE_URL=postgresql://qalbi@127.0.0.1:55432/qalbi_test
FRONTEND_URL=http://127.0.0.1:4321
NODE_ENV=development
PORT=4000
SHIPPING_CENTS=500
SHIPPING_COUNTRIES=ES
# Deixe as duas vazias para operar sem pagamento online.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Avisos por email (opcional, os dois juntos). Sem eles ninguém recebe email.
RESEND_API_KEY=
NOTIFY_FROM=
# Obrigatório em produção; igual na Vercel. Gere com: openssl rand -hex 24
PROXY_SECRET=
