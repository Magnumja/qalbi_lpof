DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FRONTEND_URL=http://127.0.0.1:4321
PORT=4000
NODE_ENV=development
# Configure primeiro as chaves TEST do Stripe; nunca comite os valores.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Defina o frete real em centavos antes de publicar. 0 significa envio gratuito.
SHIPPING_CENTS=0
SHIPPING_COUNTRIES=ES
# Seed opcional de primeiro acesso: configure o par somente no backend Render.
# Não há senha padrão. Reiniciar não redefine uma conta que já existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Qalbi Atelier
